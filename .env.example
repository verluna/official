# OpenAI API Key for chat assistant
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxx

# Resend API Key for transactional emails (contact form, scorecard results, newsletter)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# From email address for Resend (must be verified domain)
# RESEND_FROM_EMAIL=Verluna <hello@verluna.com>

# HubSpot Private App Access Token (for lead capture and CRM integration)
# Create at: Settings > Integrations > Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-xxxxxxxxxx

# Upstash Redis (for rate limiting)
# Get from https://console.upstash.com — create a Redis database
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxx

# JWT Secret for signed tokens (scorecard reports, newsletter confirmation)
# Generate with: openssl rand -hex 32
JWT_SECRET=xxxxxxxxxx

# Public site URL (used for email links)
NEXT_PUBLIC_SITE_URL=https://verluna.com
